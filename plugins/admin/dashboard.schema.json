          "description": "اسم المحكمة وشعارها ولونها وقناة السجلات",
          "fields": [
            {
              "id": "settings.court.name",
              "type": "text",
              "label": "اسم المحكمة",
              "storageKey": "settings",
              "path": "court.name",
              "placeholder": "المحكمة العليا"
            },
            {
              "id": "settings.court.logo",
              "type": "text",
              "label": "رابط شعار المحكمة",
              "storageKey": "settings",
