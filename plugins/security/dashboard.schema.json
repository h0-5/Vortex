{
  "version": 1,
  "contentMode": "schema",
  "tabs": [
    {
      "id": "general",
      "label": "عام",
      "description": "التحكم الرئيسي بنظام الحماية: التشغيل، قناة الأمان، التبييض، ورتب الإجراءات.",
      "sections": [
        {
          "id": "general.enable",
          "title": "التشغيل",
          "description": "مفتاح النظام كاملاً وقناة تقارير الأمان.",
          "fields": [
            {
              "id": "protection-enable",
              "type": "switch",
              "label": "تفعيل الحماية",
              "description": "تشغيل جميع حمايات النظام. عند إيقافه لا تُطبَّق أي حماية.",
              "storageKey": "settings",
              "path": "protection.enable",
              "defaultValue": true
            },
            {
              "id": "security-channel",
              "type": "channel_select",
              "label": "قناة تقارير الأمان",
              "description": "القناة التي تُرسل إليها التقارير عند تدخل الحماية (اختياري).",
              "storageKey": "settings",
              "path": "security.channelId",
              "defaultValue": ""
            }
          ]
        },
        {
          "id": "general.whitelist",
          "title": "التبييض",
          "description": "الرتب المعفاة من جميع إجراءات الحماية.",
          "fields": [
            {
              "id": "whitelist-roles",
              "type": "text",
              "label": "الرتب المعفاة (معرّفات)",
              "description": "معرّف رتبة واحد في كل سطر.",
              "storageKey": "settings",
              "path": "protection.whitelist_roles",
              "defaultValue": "",
              "multiline": true,
              "placeholder": "معرّف رتبة\nمعرّف رتبة أخرى"
            }
          ]
        },
        {
          "id": "general.actions",
          "title": "رتب الإجراءات",
          "description": "مطلوبة لإجراءي الميوت (4) والسجن (5).",
          "fields": [
            {
              "id": "mute-role",
              "type": "role_select",
              "label": "رتبة الميوت",
              "description": "تُعطى للعضو عند تنفيذ إجراء 'ميوت'.",
              "storageKey": "settings",
              "path": "protection.actions.mute_role",
              "defaultValue": ""
            },
            {
              "id": "jail-role",
              "type": "role_select",
              "label": "رتبة السجن",
              "description": "تُعطى للعضو عند تنفيذ إجراء 'سجن'.",
              "storageKey": "settings",
              "path": "protection.actions.jail_role",
              "defaultValue": ""
            }
          ]
        }
      ]
    },
    {
      "id": "anti",
      "label": "الحمايات",
      "description": "كل حمايات النظام القديم: منع الحظر والكير وإنشاء وحذف القنوات والرتب والبوتات والويب هوكس.",
      "sections": [
        {
          "id": "anti.ban",
          "title": "منع الحظر (Anti-Ban)",
          "description": "إذا تجاوز شخص الحد خلال 10 ثوانٍ: يُرفع الحظر تلقائيًا وتُطبَّق العقوبة عليه.",
          "fields": [
            {
              "id": "anti-ban-enabled",
              "type": "switch",
              "label": "التفعيل",
              "storageKey": "settings",
              "path": "protection.anti_ban.enabled",
              "defaultValue": false
            },
            {
              "id": "anti-ban-action",
              "type": "select",
              "label": "العقوبة عند التجاوز",
              "storageKey": "settings",
              "path": "protection.anti_ban.action",
              "defaultValue": "1",
              "options": [
                { "label": "كير", "value": "1" },
                { "label": "إزالة الرتب", "value": "2" },
                { "label": "حظر", "value": "3" },
                { "label": "ميوت", "value": "4" },
                { "label": "سجن", "value": "5" }
              ]
            },
            {
              "id": "anti-ban-limit",
